<ContentDialog
    x:Class="GMap.NET.WindowsPresentation.TilePrefetcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GMap.NET - Descargando teselas"
    PrimaryButtonText="Cancelar"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Grid Width="360" Height="90">
        <TextBlock Name="Label1" VerticalAlignment="Top" Margin="0,5,0,0" Text="ready" />
        <ProgressBar Name="ProgressBar1" Value="0" VerticalAlignment="Bottom" Margin="0,0,100,10" Height="20" />
        <TextBlock Text="please wait..." VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,10" Name="Label2" FontWeight="Bold" />
    </Grid>
</ContentDialog>